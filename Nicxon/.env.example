# ---------------------------------------------------------------
#  Library RAG Chatbot � Environment Variables
#
#  HOW TO USE:
#    1. Copy this file:   cp .env.example .env      (Linux/Mac)
#                         copy .env.example .env    (Windows CMD)
#    2. Fill in YOUR API keys below (replace the placeholder text)
#    3. Run:              docker compose up
#
#  The .env file is YOUR private file � never share or commit it.
# ---------------------------------------------------------------

# -- REQUIRED -------------------------------------------------
# Google AI / Gemini � used for the LLM and (optionally) embeddings
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# -- OPTIONAL -------------------------------------------------
# Only needed if you use the Groq or OpenRouter evaluation scripts.
# The main chatbot (chainlit_app.py) does NOT require these.

# Groq (free tier available): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -- EMBEDDING BACKEND (advanced) -----------------------------
# Controls which vector database + embedding model the chatbot uses.
# Options: google (default) | jina | qwen
# "google" requires GOOGLE_API_KEY above.
# "jina" and "qwen" run locally � no extra key needed, but they
# download a model (~600 MB for jina, ~4 GB for qwen) on first start.
EMBEDDING_BACKEND=jina

# -- CHAINLIT PORT (optional) ----------------------------------
# Change 8000 here AND in docker-compose.yml if you need a different port.
# CHAINLIT_PORT=8000
